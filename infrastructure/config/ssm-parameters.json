{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AxiePro SSM Parameters Manifest",
  "description": "Defines all required SSM parameters for AxiePro deployment across environments",
  "parameters": {
    "database": {
      "description": "Aurora PostgreSQL connection parameters",
      "parameters": [
        {
          "key": "host",
          "name": "/axiepro/{env}/database/host",
          "description": "Aurora cluster endpoint",
          "type": "String",
          "required": true,
          "source": "cdk_output",
          "source_key": "DatabaseStack.ClusterEndpoint",
          "example": "axiepro-cluster.cluster-xyz.us-west-2.rds.amazonaws.com"
        },
        {
          "key": "port",
          "name": "/axiepro/{env}/database/port",
          "description": "Database port",
          "type": "String",
          "required": true,
          "default": "5432"
        },
        {
          "key": "name",
          "name": "/axiepro/{env}/database/name",
          "description": "Database name",
          "type": "String",
          "required": true,
          "default": "axiepro"
        },
        {
          "key": "user",
          "name": "/axiepro/{env}/database/user",
          "description": "Database username",
          "type": "String",
          "required": true,
          "default": "axiepro_admin"
        },
        {
          "key": "schema",
          "name": "/axiepro/{env}/database/schema",
          "description": "Database schema",
          "type": "String",
          "required": true,
          "default": "axie"
        }
      ]
    },
    "redis": {
      "description": "ElastiCache Redis connection parameters",
      "parameters": [
        {
          "key": "endpoint",
          "name": "/axiepro/{env}/redis/endpoint",
          "description": "Redis cluster endpoint",
          "type": "String",
          "required": true,
          "source": "cdk_output",
          "source_key": "CacheStack.RedisEndpoint",
          "example": "axiepro-redis.abc123.ng.0001.usw2.cache.amazonaws.com"
        },
        {
          "key": "port",
          "name": "/axiepro/{env}/redis/port",
          "description": "Redis port",
          "type": "String",
          "required": true,
          "default": "6379"
        },
        {
          "key": "ssl",
          "name": "/axiepro/{env}/redis/ssl",
          "description": "Use SSL for Redis connection",
          "type": "String",
          "required": true,
          "default": "true"
        },
        {
          "key": "ttl_default",
          "name": "/axiepro/{env}/redis/ttl_default",
          "description": "Default cache TTL in seconds",
          "type": "String",
          "required": false,
          "default": "300"
        }
      ]
    },
    "secrets": {
      "description": "API keys and sensitive configuration",
      "parameters": [
        {
          "key": "skymavis_api_key",
          "name": "/axiepro/{env}/secrets/skymavis-key",
          "description": "SkyMavis API key for marketplace data",
          "type": "SecureString",
          "required": true,
          "manual": true,
          "instructions": "Obtain from https://developers.skymavis.com/console"
        },
        {
          "key": "moralis_api_key",
          "name": "/axiepro/{env}/secrets/moralis-key",
          "description": "Moralis API key for blockchain metadata (backup)",
          "type": "SecureString",
          "required": false,
          "manual": true,
          "instructions": "Obtain from https://admin.moralis.io/settings"
        },
        {
          "key": "internal_secret",
          "name": "/axiepro/{env}/secrets/internal",
          "description": "Internal secret for service-to-service auth",
          "type": "SecureString",
          "required": true,
          "auto_generate": true,
          "length": 32
        },
        {
          "key": "jwt_secret",
          "name": "/axiepro/{env}/secrets/jwt-secret",
          "description": "JWT signing secret for user authentication",
          "type": "SecureString",
          "required": true,
          "auto_generate": true,
          "length": 64
        }
      ]
    },
    "application": {
      "description": "Application configuration",
      "parameters": [
        {
          "key": "environment",
          "name": "/axiepro/{env}/app/environment",
          "description": "Environment name (dev/staging/production)",
          "type": "String",
          "required": true,
          "allowed_values": ["dev", "staging", "production"]
        },
        {
          "key": "log_level",
          "name": "/axiepro/{env}/app/log_level",
          "description": "Application log level",
          "type": "String",
          "required": true,
          "default": "INFO",
          "allowed_values": ["DEBUG", "INFO", "WARNING", "ERROR"]
        },
        {
          "key": "region",
          "name": "/axiepro/{env}/app/region",
          "description": "AWS region",
          "type": "String",
          "required": true,
          "default": "us-west-2"
        },
        {
          "key": "cors_origins",
          "name": "/axiepro/{env}/app/cors_origins",
          "description": "Allowed CORS origins (comma-separated)",
          "type": "String",
          "required": true,
          "default": "http://localhost:3000",
          "example": "https://axiepro.com,https://www.axiepro.com"
        }
      ]
    },
    "monitoring": {
      "description": "Monitoring and observability",
      "parameters": [
        {
          "key": "sentry_dsn",
          "name": "/axiepro/{env}/monitoring/sentry_dsn",
          "description": "Sentry DSN for error tracking",
          "type": "String",
          "required": false,
          "manual": true
        },
        {
          "key": "cloudwatch_namespace",
          "name": "/axiepro/{env}/monitoring/cloudwatch_namespace",
          "description": "CloudWatch custom metrics namespace",
          "type": "String",
          "required": true,
          "default": "AxiePro"
        }
      ]
    }
  }
}
