{
  "name": "axiepro-infrastructure",
  "version": "1.0.0",
  "description": "AWS CDK Infrastructure for AxiePro - Axie Infinity Analytics Platform",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "synth": "cdk synth",
    "deploy:dev": "cdk deploy --all -c environment=development --require-approval never",
    "deploy:staging": "cdk deploy --all -c environment=staging --require-approval broadening",
    "deploy:prod": "cdk deploy --all -c environment=production --require-approval broadening",
    "destroy:dev": "cdk destroy --all -c environment=development --force",
    "diff": "cdk diff --all",
    "lint": "eslint . --ext .ts",
    "bootstrap": "cdk bootstrap"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.4.2",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "aws-cdk": "^2.170.0",
    "eslint": "^9.16.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
