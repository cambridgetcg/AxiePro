# Database (traditional auth - not needed if using IAM auth)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@cardforum.cn4c2su0o42n.us-east-1.rds.amazonaws.com:5432/cardforum

# IAM Database Authentication (recommended - no passwords needed)
USE_IAM_AUTH=true
DB_HOST=cardforum.cn4c2su0o42n.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=cardforum
DB_USER=iamuser

# Redis
REDIS_URL=redis://localhost:6379

# External APIs (Goldrush - formerly Covalent)
GOLDRUSH_API_KEY=your_goldrush_api_key_here

# Sky Mavis API (for Axie marketplace, traits, genes, breed count)
SKYMAVIS_API_KEY=your_skymavis_api_key_here

# Optional: Chainstack/Alchemy RPC
RONIN_RPC_URL=https://api.roninchain.com/rpc

# App Settings
DEBUG=true
LOG_LEVEL=INFO
