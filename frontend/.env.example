# Frontend Environment Variables
# Copy this file to .env.local for local development
# Set these in Vercel dashboard for production deployments

# API URL - Backend server endpoint
# For local development: leave empty to use Next.js proxy (recommended)
# For production: set to your deployed backend URL
NEXT_PUBLIC_API_URL=

# Examples:
# Local development (uses proxy): NEXT_PUBLIC_API_URL=
# Direct local backend: NEXT_PUBLIC_API_URL=http://localhost:8000
# Production: NEXT_PUBLIC_API_URL=https://api.axiepro.io
